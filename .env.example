# ═══════════════════════════════════════════════════════════════════════════
# Central environment configuration — copy to `.env` in the REPO ROOT.
# All components load this single file via `leadgen.config`:
#   - leadgen.agents.s* (both LangGraph agents)
#   - leadgen.api (FastAPI orchestrator)
#   - scripts/ (find_email.py, print_brightdata_tools.py)
#   - frontend (Vite reads VITE_* from this file via envDir: '..')
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime artifacts ──────────────────────────────────────────────────────
# Reports, exports, JSONL telemetry and checkpointer DBs live under var/
# (gitignored). Override the root here if you need them elsewhere.
#LEADGEN_VAR_DIR=var

# ── Hunter.io — consumed by leadgen.api /hunter/* and scripts/find_email.py ──
HUNTER_API_KEY=your_hunter_api_key_here

# ── OpenAI-compatible LLM endpoint — consumed by both agents and the backend ──
# Any OpenAI-compatible provider works, e.g.:
#   https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
# Model name sent to the endpoint as `model=`. Required.
OPENAI_MODEL=gpt-4o-mini
# Optional: comma-separated rotation list used for 429 / timeout fallback; when set it overrides OPENAI_MODEL
#OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
# Optional: per-million-token costs in USD used for the run-end cost summary (defaults: 0.250 / 2.000)
#OPENAI_INPUT_COST_PER_M=
#OPENAI_OUTPUT_COST_PER_M=

# ── Rate limiting — consumed by leadgen.core.llm (default 65) ──
RATE_LIMIT_CYCLE_WAIT_SECONDS=65

# ── Bright Data MCP — consumed by leadgen.core.clients.bright_data ──
BRIGHT_DATA_MCP_URL=https://mcp.brightdata.com/sse?token=your_bright_data_token_here&groups=advanced_scraping
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
# Optional alias accepted by scripts/print_brightdata_tools.py
#BRIGHTDATA_TOKEN=

# ── SerpAPI — consumed by the LinkedIn Finder agent ──
SERPAPI_API_KEY=your_serpapi_key_here

# ── Logging — consumed by leadgen.core.telemetry (all optional, defaults shown) ──
#LOG_LEVEL=INFO
#LOG_DIR=var/logs
#CENTRAL_LOG_URL=
#CENTRAL_LOG_BATCH_SIZE=50
#CENTRAL_LOG_FLUSH_INTERVAL_S=5

# ── Frontend — consumed by frontend/src/api.js (only VITE_* vars are exposed to the browser) ──
VITE_API_BASE_URL=http://localhost:8000

# ── Runtime-only (do NOT set here): PIPELINE_RUN_ID is injected by the API per pipeline run ──

# ═══════════════════════════════════════════════════════════════════════════
# Central environment configuration — copy to `.env` in the REPO ROOT.
# All components load this single file:
#   - env_config.py (root scripts: hunter_linkedin_email_finder.py, printbrightdatatools.py)
#   - backend/config.py (FastAPI orchestrator)
#   - Shortlister Agent/config.py
#   - Linkedin Finder Agent/config.py
#   - frontend (Vite reads VITE_* from this file via envDir: '..')
# ═══════════════════════════════════════════════════════════════════════════

# ── Hunter.io — consumed by: env_config.py -> hunter_linkedin_email_finder.py (backend email enrichment) ──
HUNTER_API_KEY=your_hunter_api_key_here

# ── OpenAI-compatible LLM endpoint — consumed by: backend/config.py, Shortlister Agent/config.py, Linkedin Finder Agent/config.py ──
# Any OpenAI-compatible provider works, e.g.:
#   https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
# Model name sent to the endpoint as `model=`. Required.
OPENAI_MODEL=gpt-4o-mini
# Optional: comma-separated rotation list used for 429 / timeout fallback; when set it overrides OPENAI_MODEL
#OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
# Optional: per-million-token costs in USD used for the run-end cost summary (defaults: 0.250 / 2.000)
#OPENAI_INPUT_COST_PER_M=
#OPENAI_OUTPUT_COST_PER_M=

# ── Rate limiting — consumed by: both agent config.py (default 65) ──
RATE_LIMIT_CYCLE_WAIT_SECONDS=65

# ── Bright Data MCP — consumed by: both agent config.py, env_config.py -> printbrightdatatools.py ──
BRIGHT_DATA_MCP_URL=https://mcp.brightdata.com/sse?token=your_bright_data_token_here&groups=advanced_scraping
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
# Optional alias accepted by printbrightdatatools.py
#BRIGHTDATA_TOKEN=

# ── SerpAPI — consumed by: Linkedin Finder Agent/config.py ──
SERPAPI_API_KEY=your_serpapi_key_here

# ── Logging — consumed by: logging_utils (all optional, defaults shown) ──
#LOG_LEVEL=INFO
#LOG_DIR=logs
#CENTRAL_LOG_URL=
#CENTRAL_LOG_BATCH_SIZE=50
#CENTRAL_LOG_FLUSH_INTERVAL_S=5

# ── Frontend — consumed by: frontend/src/api.js (only VITE_* vars are exposed to the browser) ──
VITE_API_BASE_URL=http://localhost:8000

# ── Runtime-only (do NOT set here): PIPELINE_RUN_ID is injected by backend/main.py per pipeline run ──

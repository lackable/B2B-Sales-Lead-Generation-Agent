# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-2
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=v1

# Rate Limiting
RATE_LIMIT_CYCLE_WAIT_SECONDS=65

# Bright Data MCP Integration
BRIGHT_DATA_MCP_URL=https://mcp.brightdata.com/sse?token=your_bright_data_token_here&groups=advanced_scraping
BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
